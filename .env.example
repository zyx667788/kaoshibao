# ===== 考试宝题库爬取工具 - 环境变量配置 =====
# 复制此文件为 .env 并修改对应值
# docker-compose.yml 会自动读取 .env 文件

# ---- Flask 应用配置 ----
# Flask 密钥（必须设置，否则使用临时随机值，重启后session失效）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string

# ---- 认证配置 ----
# API认证token，设置后所有API请求需携带 X-Auth-Token 头或 ?token= 参数
# 留空则关闭认证（向后兼容）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# ---- 日志配置 ----
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 运行时配置（Docker专用，本地开发一般不需要）----
# Python输出不缓冲（Docker日志实时输出）
PYTHONUNBUFFERED=1

# Playwright浏览器安装路径（Docker镜像内固定路径）
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ---- PostgreSQL 数据库配置（可选，未配置则使用文件存储）----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=kaoshibao
PG_USER=postgres
PG_PASSWORD=
