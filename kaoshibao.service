[Unit]
Description=Kaoshibao Flask App (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/var/www/kaoshibao
EnvironmentFile=/var/www/kaoshibao/.env
ExecStart=/var/www/kaoshibao/venv/bin/gunicorn --bind 127.0.0.1:5678 --workers 1 --timeout 120 --access-logfile /var/www/kaoshibao/logs/gunicorn_access.log --error-logfile /var/www/kaoshibao/logs/gunicorn_error.log --env SCRIPT_NAME=/web app:app
Restart=always
RestartSec=5
User=www-data
Group=www-data
ReadWritePaths=/var/www/kaoshibao/logs /var/www/kaoshibao/output /var/www/kaoshibao/data

[Install]
WantedBy=multi-user.target
